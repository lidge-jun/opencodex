{
  "//": "Shared by desktop/src-tauri/src/login_registration.rs and tests/service/service-desktop-login-registration.test.ts (#6972). Each case is one macOS Start at Login registration; expect.loginEnabled is what Startup safety reports for this app, expect.tray is what the tray shows. Only tray \"on\" is checked, and it must coincide with loginEnabled. Placeholders: {APP} this copy, {OTHER_APP} another existing copy, {MISSING_APP} a copy that does not exist, {PLIST} ~/Library/LaunchAgents/OpenCodex.plist, {OTHER_PLIST} another existing plist, {UID} 501. plist null means the LaunchAgent file is absent; disabled null means print-disabled fails; loaded is launchctl print: stdout, or an exit status with stderr (and optional signal), or a failure such as a timeout.",
  "cases": [
    {
      "name": "loaded from this copy and this plist",
      "plist": {
        "Label": "OpenCodex",
        "RunAtLoad": true,
        "ProgramArguments": [
          "{APP}",
          "--autostart"
        ]
      },
      "disabled": "disabled services = {\n\t\"com.apple.example\" => disabled\n\t\"OpenCodex\" => enabled\n}",
      "loaded": {
        "stdout": "gui/{UID}/OpenCodex = {\n\tactive count = 1\n\tpath = {PLIST}\n\tstate = running\n\tprogram = {APP}\n}"
      },
      "expect": {
        "tray": "on",
        "loginEnabled": true,
        "loginRegistration": "loaded"
      }
    },
    {
      "name": "valid registration not loaded yet",
      "plist": {
        "Label": "OpenCodex",
        "RunAtLoad": true,
        "ProgramArguments": [
          "{APP}",
          "--autostart"
        ]
      },
      "disabled": "disabled services = {\n\t\"com.apple.example\" => disabled\n\t\"OpenCodex\" => enabled\n}",
      "loaded": {
        "status": 113,
        "stderr": "Could not find service \"OpenCodex\" in domain for user gui: {UID}"
      },
      "expect": {
        "tray": "on",
        "loginEnabled": true,
        "loginRegistration": "registered-not-loaded"
      }
    },
    {
      "name": "valid registration not loaded yet, Bad request form",
      "plist": {
        "Label": "OpenCodex",
        "RunAtLoad": true,
        "ProgramArguments": [
          "{APP}",
          "--autostart"
        ]
      },
      "disabled": "disabled services = {\n\t\"com.apple.example\" => disabled\n\t\"OpenCodex\" => enabled\n}",
      "loaded": {
        "status": 113,
        "stderr": "Bad request.\nCould not find service \"OpenCodex\" in domain for user gui: {UID}\n"
      },
      "expect": {
        "tray": "on",
        "loginEnabled": true,
        "loginRegistration": "registered-not-loaded"
      }
    },
    {
      "name": "no override for OpenCodex",
      "plist": {
        "Label": "OpenCodex",
        "RunAtLoad": true,
        "ProgramArguments": [
          "{APP}",
          "--autostart"
