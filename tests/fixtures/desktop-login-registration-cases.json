      "disabled": "disabled services = {\n\t\"com.apple.example\" => disabled\n}",
      "loaded": {
        "stdout": "gui/{UID}/OpenCodex = {\n\tactive count = 1\n\tpath = {PLIST}\n\tstate = running\n\tprogram = {APP}\n}"
