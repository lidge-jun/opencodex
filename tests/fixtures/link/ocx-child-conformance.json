  "framingCases": [
    {
      "id": "strip_caller_credentials_and_connection_nominated",
      "rawHeaders": [
        [
          "Host",
          "127.0.0.1:10100"
        ],
        [
          "Content-Length",
          "42"
        ],
        [
          "Authorization",
          "Bearer caller-tok-1"
        ],
        [
          "api-key",
          "az-caller-1"
        ],
        [
          "x-api-key",
          "ant-caller-1"
        ],
        [
          "x-goog-api-key",
          "goog-caller-1"
        ],
        [
          "x-opencodex-api-key",
          "ocx-caller-1"
        ],
        [
          "chatgpt-account-id",
          "acct-local-1"
        ],
        [
          "cookie",
          "sid=local1"
        ],
        [
          "Connection",
          "keep-alive, x-drop-hop"
        ],
        [
          "Keep-Alive",
          "timeout=5"
        ],
        [
          "x-drop-hop",
          "secret-hop"
        ],
        [
          "x-trace-id",
          "trace-keep-1"
        ],
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "expectedOutcome": "allow",
      "expectedSurvivedHeaders": [
        "content-type",
        "x-trace-id"
      ]
    },
    {
      "id": "allow_lone_transfer_encoding_chunked",
      "rawHeaders": [
        [
          "Host",
          "127.0.0.1:10100"
        ],
        [
          "Transfer-Encoding",
          "chunked"
        ],
        [
          "Content-Type",
          "application/json"
        ]
      ],
      "expectedOutcome": "allow",
      "expectedSurvivedHeaders": [
        "content-type"
      ]
    },
    {
      "id": "reject_cl_and_te_smuggling",
      "rawHeaders": [
        [
          "Content-Length",
          "10"
        ],
        [
          "Transfer-Encoding",
          "chunked"
        ]
      ],
      "expectedOutcome": "reject_400_smuggling",
      "expectedSurvivedHeaders": []
    },
    {
      "id": "reject_duplicate_content_length",
