---
import {
  getTelemetryDashboardCopy,
  resolveTelemetryDashboardLocale,
  TELEMETRY_DASHBOARD_STRINGS,
  type TelemetryDashboardLocale,
} from "../data/telemetry-dashboard-i18n";
import {
  DEFAULT_TELEMETRY_RANGE,
  GITHUB_RELEASES_URL,
  GITHUB_REPO_SLUG,
  NPM_DOWNLOADS_MONTHLY_URL,
  NPM_DOWNLOADS_WEEKLY_URL,
  NPM_DOWNLOADS_YEARLY_URL,
  NPM_PACKAGE_NAME,
  OUTCOME_COLORS,
  TELEMETRY_GUIDE_PATH,
  TELEMETRY_RANGES,
  TELEMETRY_STATS_ENDPOINT,
  TOKEN_MIX_COLORS,
  TOKSCALE_REPO_URL,
  getLocalizedWeekdayLabels,
} from "./telemetry-dashboard/index";

interface Props {
  locale?: TelemetryDashboardLocale;
}

const routeLocale = Astro.locals?.starlightRoute?.locale;
const locale = resolveTelemetryDashboardLocale(Astro.props.locale ?? routeLocale);
const copy = getTelemetryDashboardCopy(locale);

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const prefix = locale === "en" ? base : `${base}${locale}/`;

const showGuideLink =
  Object.keys(import.meta.glob("../content/docs/guides/telemetry.{md,mdx}")).length > 0;
const guideHref = `${prefix}${TELEMETRY_GUIDE_PATH}`;
const weekdayLabels = getLocalizedWeekdayLabels(locale);

const rangeLabels: Record<(typeof TELEMETRY_RANGES)[number], string> = {
  "7d": copy.range7d,
  "30d": copy.range30d,
  "90d": copy.range90d,
  "365d": copy.range365d,
};

const kpiCards = [
  { id: "activeInstalls", label: copy.kpiActiveInstalls, initial: "0", title: "0 (0 install-days)" },
  { id: "newInstalls", label: copy.kpiNewInstalls, initial: "0", title: "0" },
  { id: "requests", label: copy.kpiRequests, initial: "0", title: "0" },
  { id: "tokens", label: copy.kpiTokens, initial: "0", title: "0" },
  { id: "activeHours", label: copy.kpiActiveHours, initial: "0h", title: "0h (0 min)" },
] as const;

const tokenBuckets = [
  { id: "input", label: copy.tokenInput, color: TOKEN_MIX_COLORS.input },
  { id: "cacheRead", label: copy.tokenCacheRead, color: TOKEN_MIX_COLORS.cacheRead },
  { id: "cacheWrite", label: copy.tokenCacheWrite, color: TOKEN_MIX_COLORS.cacheWrite },
  { id: "output", label: copy.tokenOutput, color: TOKEN_MIX_COLORS.output },
  { id: "reasoning", label: copy.tokenReasoning, color: TOKEN_MIX_COLORS.reasoning },
] as const;

const outcomeItems = [
  { id: "completed", label: copy.outcomeCompleted, color: OUTCOME_COLORS.completed },
  { id: "incomplete", label: copy.outcomeIncomplete, color: OUTCOME_COLORS.incomplete },
  { id: "aborted", label: copy.outcomeAborted, color: OUTCOME_COLORS.aborted },
  { id: "failed", label: copy.outcomeFailed, color: OUTCOME_COLORS.failed },
] as const;

const skeletonCells = Array.from({ length: 53 * 7 }, (_, idx) => idx);
---

<div
  class="td-root"
  data-telemetry-dashboard
  data-dashboard-state="loading"
  data-locale={locale}
  data-stats-endpoint={TELEMETRY_STATS_ENDPOINT}
  data-default-range={DEFAULT_TELEMETRY_RANGE}
  data-npm-weekly-url={NPM_DOWNLOADS_WEEKLY_URL}
  data-npm-monthly-url={NPM_DOWNLOADS_MONTHLY_URL}
  data-npm-yearly-url={NPM_DOWNLOADS_YEARLY_URL}
  data-github-releases-url={GITHUB_RELEASES_URL}
  data-copy={JSON.stringify(TELEMETRY_DASHBOARD_STRINGS[locale])}
>
  <!-- 1. Overview Header + Range Pills + Privacy Callout + KPI Strip -->
  <section class="td-panel td-overview" aria-labelledby="_top">
    <div class="td-overview-header">
      <div class="td-overview-title-group">
        <div class="td-title-row">
          <h1 id="_top" class="td-title">{copy.title}</h1>
          <span class="td-badge">{copy.privacyBadge}</span>
          <span class="td-badge" data-self-reported-label>{copy.selfReportedLabel}</span>
        </div>
        <p class="td-subtitle">{copy.subtitle}</p>
        <div class="td-meta-row">
          <span class="td-meta-item" data-updated-label>
            {copy.updatedPrefix}: {copy.updatedPending}
          </span>
          <span class="td-meta-sep" aria-hidden="true">·</span>
          <span class="td-meta-item td-mono">GET /v1/stats</span>
          <span
            class="td-loading-inline"
            data-state-panel="loading"
            role="status"
            aria-live="polite"
          >
            <span class="td-spinner" aria-hidden="true"></span>
            <strong data-loading-title>{copy.stateLoadingTitle}</strong>
            <span class="td-sr-only" data-loading-body>{copy.stateLoadingBody}</span>
          </span>
        </div>
      </div>

      <div class="td-controls">
        <div class="td-range-pills" role="group" aria-label={copy.rangeAria}>
          {TELEMETRY_RANGES.map((range) => (
            <button
              type="button"
              class="td-pill"
              data-range-pill={range}
              aria-pressed={range === DEFAULT_TELEMETRY_RANGE ? "true" : "false"}
            >
              {rangeLabels[range]}
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="td-privacy-callout">
      <p class="td-privacy-text">
        {copy.privacyBody}{" "}
        <span class="td-privacy-optout">{copy.privacyOptOutHint}</span>
        {showGuideLink && (
          <>
            {" "}
            <a class="td-inline-link" href={guideHref}>
              {copy.privacyGuideLink} →
            </a>
          </>
        )}
      </p>
    </div>

    <!-- Explicit state banners: empty ("Collector not deployed yet"), error -->
    <div class="td-state-region" data-state-region>
      <div
        class="td-state-banner td-state-empty"
        data-state-panel="empty"
        role="status"
        aria-live="polite"
        hidden
      >
        <div class="td-state-copy">
          <strong data-empty-title>{copy.stateEmptyTitle}</strong>
          <span data-empty-body>{copy.stateEmptyBody}</span>
        </div>
      </div>

      <div
        class="td-state-banner td-state-error"
        data-state-panel="error"
        role="alert"
        hidden
      >
        <div class="td-state-copy">
          <strong data-error-title>{copy.stateErrorTitle}</strong>
          <span data-error-body>{copy.stateErrorBody}</span>
        </div>
        <button type="button" class="td-retry-btn" data-retry-btn>
          {copy.retryButton}
        </button>
      </div>
    </div>

    <!-- 2. KPI Strip (adapted from tokscale ProfileOverview) -->
    <dl class="td-kpi-strip" aria-label={copy.kpiSectionAria}>
      {kpiCards.map((card) => (
        <div class="td-kpi-cell" data-kpi-card={card.id}>
          <dt class="td-kpi-label">{card.label}</dt>
          <dd
            class="td-kpi-value"
            data-kpi-value={card.id}
            title={card.title}
          >
            {card.initial}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- 3. Disjoint Token Mix Bar (adapted from tokscale TokenBreakdown) -->
  <section class="td-panel" aria-labelledby="td-token-mix-heading">
    <header class="td-panel-header">
      <div>
        <h2 id="td-token-mix-heading" class="td-panel-title">
          {copy.tokenMixTitle}
        </h2>
        <p class="td-panel-subtitle">{copy.tokenMixSubtitle}</p>
      </div>
      <div class="td-panel-total">
        <span class="td-panel-total-label">{copy.kpiTokens}</span>
        <strong
          class="td-panel-total-value"
          data-token-mix-total
          title="0"
        >
          0
        </strong>
      </div>
    </header>
    <div class="td-panel-body">
      <div
        class="td-token-bar"
        data-token-mix-bar
        role="img"
        aria-label={copy.tokenMixTitle}
      >
        {tokenBuckets.map((bucket) => (
          <span
            class="td-token-segment"
            data-token-segment={bucket.id}
            style={`background-color: ${bucket.color}; flex: 1 1 0;`}
            title={`${bucket.label}: 0 (0.0%)`}
          />
        ))}
      </div>

      <dl class="td-token-list">
        {tokenBuckets.map((bucket) => (
          <div
            class="td-token-item"
            data-token-bucket={bucket.id}
            style={`--segment-color: ${bucket.color};`}
          >
            <div class="td-token-label-row">
              <span
                class="td-color-swatch"
                style={`background-color: ${bucket.color};`}
                aria-hidden="true"
              />
              <dt class="td-token-label">{bucket.label}</dt>
            </div>
            <dd class="td-token-value-row">
              <span data-token-value={bucket.id} title="0">0</span>
              <span class="td-token-pct" data-token-pct={bucket.id}>0.0%</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 4. Activity: 52-week Heatmap + ECharts Stacked Daily Chart -->
  <div class="td-activity-stack">
    <!-- 52-week Contribution Heatmap (adapted from tokscale ProfileContributionGraph) -->
    <section class="td-panel" aria-labelledby="td-heatmap-heading">
      <header class="td-panel-header">
        <div>
          <h2 id="td-heatmap-heading" class="td-panel-title">
            {copy.heatmapTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.heatmapSubtitle}</p>
        </div>
        <div class="td-heatmap-summary" aria-live="polite">
          <span class="td-summary-pill" data-heatmap-active-days>
            {copy.heatmapActiveDays.replace("{count}", "0")}
          </span>
          <span class="td-summary-sub" data-heatmap-peak hidden></span>
        </div>
      </header>

      <div class="td-panel-body td-heatmap-body">
        <div class="td-heatmap-scroll" data-heatmap-scroll>
          <div
            class="td-heatmap-months"
            data-heatmap-months
            style="--heatmap-weeks: 53;"
            aria-hidden="true"
          ></div>
          <div class="td-heatmap-calendar-row">
            <div class="td-heatmap-day-labels" aria-hidden="true">
              <span style="grid-row: 2;">{weekdayLabels.mon}</span>
              <span style="grid-row: 4;">{weekdayLabels.wed}</span>
              <span style="grid-row: 6;">{weekdayLabels.fri}</span>
            </div>
            <div
              class="td-heatmap-grid"
              data-heatmap-grid
              style="--heatmap-weeks: 53;"
              role="group"
              aria-label={copy.heatmapTitle}
              aria-describedby="td-heatmap-kbd-hint"
            >
              {skeletonCells.map(() => (
                <button
                  type="button"
                  class="td-heatmap-cell"
                  data-grade="0"
                  tabindex="-1"
                  disabled
                  aria-hidden="true"
                />
              ))}
            </div>
          </div>
        </div>

        <div
          id="td-heatmap-tooltip"
          class="td-heatmap-tooltip"
          data-heatmap-tooltip
          data-active="false"
          role="tooltip"
          aria-hidden="true"
        >
          &nbsp;
        </div>

        <footer class="td-heatmap-footer">
          <span class="td-heatmap-range-text" data-heatmap-range-label>
            365d UTC
          </span>
          <div class="td-heatmap-legend" aria-label={`${copy.heatmapLess} – ${copy.heatmapMore}`}>
            <span>{copy.heatmapLess}</span>
            <div class="td-heatmap-swatches">
              {([0, 1, 2, 3, 4] as const).map((grade) => (
                <span
                  class="td-heatmap-swatch"
                  data-grade={grade}
                  aria-hidden="true"
                />
              ))}
            </div>
            <span>{copy.heatmapMore}</span>
          </div>
        </footer>
        <p id="td-heatmap-kbd-hint" class="td-sr-only">
          {copy.heatmapKeyboardHint}
        </p>
      </div>
    </section>

    <!-- ECharts Stacked Daily Usage Chart (from dailyByProvider) -->
    <section class="td-panel" aria-labelledby="td-daily-chart-heading">
      <header class="td-panel-header">
        <div>
          <h2 id="td-daily-chart-heading" class="td-panel-title">
            {copy.dailyChartTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.dailyChartSubtitle}</p>
        </div>
        <div class="td-metric-toggle" role="group" aria-label={copy.dailyChartTitle}>
          <button
            type="button"
            class="td-pill td-pill-sm"
            data-chart-metric="tokens"
            aria-pressed="true"
          >
            {copy.metricTokens}
          </button>
          <button
            type="button"
            class="td-pill td-pill-sm"
            data-chart-metric="requests"
            aria-pressed="false"
          >
            {copy.metricRequests}
          </button>
        </div>
      </header>
      <div class="td-panel-body">
        <div
          class="td-daily-chart"
          data-daily-chart
          role="img"
          aria-label={copy.dailyChartTitle}
        ></div>
        <table class="td-sr-only" data-daily-chart-table>
          <caption>{copy.dailyChartTitle}</caption>
          <thead>
            <tr>
              <th scope="col">UTC</th>
              <th scope="col">{copy.colProvider}</th>
              <th scope="col" data-daily-chart-metric-col>{copy.metricTokens}</th>
            </tr>
          </thead>
          <tbody data-daily-chart-tbody>
            <tr>
              <td colspan="3">{copy.noDataInTable}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- 5. Provider-Kind and Model-Family Share Tables (adapted from tokscale ProfileModels) -->
  <div class="td-two-col">
    <section class="td-panel" aria-labelledby="td-providers-heading">
      <header class="td-panel-header">
        <div>
          <h2 id="td-providers-heading" class="td-panel-title">
            {copy.providersTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.providersSubtitle}</p>
        </div>
      </header>
      <div class="td-table-wrap">
        <table class="td-table" data-table="providers">
          <thead>
            <tr>
              <th scope="col">{copy.colProvider}</th>
              <th scope="col" class="td-num">{copy.colRequests}</th>
              <th scope="col" class="td-num">{copy.colTokens}</th>
              <th scope="col" class="td-num">{copy.colShare}</th>
            </tr>
          </thead>
          <tbody data-tbody="providers">
            <tr class="td-empty-row">
              <td colspan="4">{copy.noDataInTable}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="td-panel" aria-labelledby="td-models-heading">
      <header class="td-panel-header">
        <div>
          <h2 id="td-models-heading" class="td-panel-title">
            {copy.modelsTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.modelsSubtitle}</p>
        </div>
      </header>
      <div class="td-table-wrap">
        <table class="td-table" data-table="models">
          <thead>
            <tr>
              <th scope="col">{copy.colModel}</th>
              <th scope="col" class="td-num">{copy.colRequests}</th>
              <th scope="col" class="td-num">{copy.colTokens}</th>
              <th scope="col" class="td-num">{copy.colShare}</th>
            </tr>
          </thead>
          <tbody data-tbody="models">
            <tr class="td-empty-row">
              <td colspan="4">{copy.noDataInTable}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- 6. Versions, Platforms, and Install Channels -->
  <div class="td-three-col">
    <section class="td-panel" aria-labelledby="td-versions-heading">
      <header class="td-panel-header">
        <div>
          <h2 id="td-versions-heading" class="td-panel-title">
            {copy.versionsTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.versionsSubtitle}</p>
        </div>
      </header>
      <div class="td-table-wrap">
        <table class="td-table" data-table="versions">
          <thead>
            <tr>
              <th scope="col">{copy.colVersion}</th>
              <th scope="col" class="td-num">{copy.colInstalls}</th>
              <th scope="col" class="td-num">{copy.colNewInstalls}</th>
              <th scope="col" class="td-num">{copy.colInstallShare}</th>
            </tr>
          </thead>
          <tbody data-tbody="versions">
            <tr class="td-empty-row">
              <td colspan="4">{copy.noDataInTable}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="td-panel" aria-labelledby="td-platforms-heading">
      <header class="td-panel-header">
        <div>
          <h2 id="td-platforms-heading" class="td-panel-title">
            {copy.platformsTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.platformsSubtitle}</p>
        </div>
      </header>
      <div class="td-table-wrap">
        <table class="td-table" data-table="platforms">
          <thead>
            <tr>
              <th scope="col">{copy.colPlatform}</th>
              <th scope="col" class="td-num">{copy.colInstalls}</th>
              <th scope="col" class="td-num">{copy.colInstallShare}</th>
            </tr>
          </thead>
          <tbody data-tbody="platforms">
            <tr class="td-empty-row">
              <td colspan="3">{copy.noDataInTable}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="td-panel" aria-labelledby="td-channels-heading">
      <header class="td-panel-header">
        <div>
          <h2 id="td-channels-heading" class="td-panel-title">
            {copy.channelsTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.channelsSubtitle}</p>
        </div>
      </header>
      <div class="td-table-wrap">
        <table class="td-table" data-table="channels">
          <thead>
            <tr>
              <th scope="col">{copy.colChannel}</th>
              <th scope="col" class="td-num">{copy.colInstalls}</th>
              <th scope="col" class="td-num">{copy.colNewInstalls}</th>
              <th scope="col" class="td-num">{copy.colInstallShare}</th>
            </tr>
          </thead>
          <tbody data-tbody="channels">
            <tr class="td-empty-row">
              <td colspan="4">{copy.noDataInTable}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- 7. Reliability (Outcome Ratio & Top Failure Causes) + Downloads (npm & GitHub Releases) -->
  <div class="td-two-col">
    <section
      class="td-panel"
      data-panel="reliability"
      aria-labelledby="td-reliability-heading"
    >
      <header class="td-panel-header">
        <div>
          <h2 id="td-reliability-heading" class="td-panel-title">
            {copy.reliabilityTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.reliabilitySubtitle}</p>
        </div>
        <div class="td-panel-total">
          <span class="td-panel-total-label">{copy.completionRateLabel}</span>
          <strong class="td-panel-total-value" data-completion-rate>
            0.0%
          </strong>
        </div>
      </header>

      <div class="td-panel-body">
        <div
          class="td-token-bar td-outcome-bar"
          data-outcome-bar
          role="img"
          aria-label={copy.reliabilityTitle}
        >
          {outcomeItems.map((item) => (
            <span
              class="td-token-segment"
              data-outcome-segment={item.id}
              style={`background-color: ${item.color}; flex: 1 1 0;`}
              title={`${item.label}: 0 (0.0%)`}
            />
          ))}
        </div>

        <dl class="td-token-list td-outcome-list">
          {outcomeItems.map((item) => (
            <div
              class="td-token-item"
              data-outcome-item={item.id}
              style={`--segment-color: ${item.color};`}
            >
              <div class="td-token-label-row">
                <span
                  class="td-color-swatch"
                  style={`background-color: ${item.color};`}
                  aria-hidden="true"
                />
                <dt class="td-token-label">{item.label}</dt>
              </div>
              <dd class="td-token-value-row">
                <span data-outcome-count={item.id} title="0">0</span>
                <span class="td-token-pct" data-outcome-pct={item.id}>0.0%</span>
              </dd>
            </div>
          ))}
        </dl>

        <h3 class="td-subheading">{copy.topErrorsTitle}</h3>
        <div class="td-table-wrap td-table-nested">
          <table class="td-table" data-table="errors">
            <thead>
              <tr>
                <th scope="col">{copy.colErrorCause}</th>
                <th scope="col" class="td-num">{copy.colErrorCount}</th>
                <th scope="col" class="td-num">{copy.colInstallShare}</th>
              </tr>
            </thead>
            <tbody data-tbody="errors">
              <tr class="td-empty-row">
                <td colspan="3">{copy.noErrorsRecorded}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section
      class="td-panel"
      data-panel="downloads"
      aria-labelledby="td-downloads-heading"
    >
      <header class="td-panel-header">
        <div>
          <h2 id="td-downloads-heading" class="td-panel-title">
            {copy.downloadsTitle}
          </h2>
          <p class="td-panel-subtitle">{copy.downloadsSubtitle}</p>
        </div>
      </header>

      <div class="td-panel-body">
        <dl class="td-downloads-grid">
          <div class="td-download-card">
            <dt class="td-kpi-label">{copy.npmWeeklyLabel}</dt>
            <dd class="td-kpi-value" data-dl-npm-weekly title={copy.downloadsUnavailable}>
              —
            </dd>
            <span class="td-download-source td-mono">{NPM_PACKAGE_NAME}</span>
          </div>
          <div class="td-download-card">
            <dt class="td-kpi-label">{copy.npmMonthlyLabel}</dt>
            <dd class="td-kpi-value" data-dl-npm-monthly title={copy.downloadsUnavailable}>
              —
            </dd>
            <span class="td-download-source td-mono">{NPM_PACKAGE_NAME}</span>
          </div>
          <div class="td-download-card">
            <dt class="td-kpi-label">{copy.npmYearlyLabel}</dt>
            <dd class="td-kpi-value" data-dl-npm-yearly title={copy.downloadsUnavailable}>
              —
            </dd>
            <span class="td-download-source td-mono">{NPM_PACKAGE_NAME}</span>
          </div>
          <div class="td-download-card">
            <dt class="td-kpi-label">{copy.githubTotalLabel}</dt>
            <dd class="td-kpi-value" data-dl-gh-total title={copy.downloadsUnavailable}>
              —
            </dd>
            <span class="td-download-source td-mono">{GITHUB_REPO_SLUG}</span>
          </div>
          <div class="td-download-card td-download-card-wide">
            <dt class="td-kpi-label">
              {copy.githubLatestLabel}{" "}
              <span class="td-mono" data-dl-gh-latest-tag></span>
            </dt>
            <dd class="td-kpi-value" data-dl-gh-latest title={copy.downloadsUnavailable}>
              —
            </dd>
            <div class="td-download-links">
              <a
                href={`https://www.npmjs.com/package/${NPM_PACKAGE_NAME}`}
                target="_blank"
                rel="noopener noreferrer"
                class="td-inline-link"
              >
