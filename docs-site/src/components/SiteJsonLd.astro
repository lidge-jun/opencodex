---
// Site-name markup for Google, emitted ONLY from a locale home page.
//
// Google's site-names rules (developers.google.com/search/docs/appearance/site-names):
//   - put the WebSite entity on the home page only, never site-wide;
//   - one WebSite object per page — duplicate/conflicting entities are ignored;
//   - for multilingual sites, emit a separate WebSite per localized home page,
//     each with a single `inLanguage` value and its own `url`/`@id`.
// Emitting one shared entity across every page and locale is what made Google
// fall back to the bare domain, so this component is home-page scoped by design.
const SITE_URL = 'https://opencodex.me';

interface Props {
	locale?: 'fr' | 'ko' | 'zh-cn' | 'zh-tw' | 'ru' | 'ja' | 'tr';
}
const { locale } = Astro.props;

// Locale path segment (root/English has none) mapped to its BCP-47 tag.
const langs = { fr: 'fr', ko: 'ko', 'zh-cn': 'zh-CN', 'zh-tw': 'zh-TW', ru: 'ru', ja: 'ja', tr: 'tr' } as const;

const homeUrl = locale ? `${SITE_URL}/${locale}/` : `${SITE_URL}/`;
const inLanguage = locale ? langs[locale] : 'en';

const descriptions = {
	en: 'One local gateway for your AI coding tools and models: use the providers you choose with Codex, Claude Code, Claude Desktop and Grok Build, and connect more tools through managed configs.',
	fr: 'Une passerelle locale unique pour vos outils de code IA et vos modèles : utilisez les fournisseurs de votre choix avec Codex, Claude Code, Claude Desktop et Grok Build, et connectez d’autres outils via des configurations gérées.',
	ko: 'AI 코딩 도구와 모델을 잇는 하나의 로컬 게이트웨이: Codex, Claude Code, Claude Desktop, Grok Build에서 원하는 프로바이더를 쓰고, 관리형 설정으로 더 많은 도구를 연결하세요.',
	'zh-CN': '一个本地网关，连接你的 AI 编程工具与模型：在 Codex、Claude Code、Claude Desktop 和 Grok Build 中使用你选择的提供商，并通过托管配置连接更多工具。',
	'zh-TW': '一個本機閘道，連接你的 AI 程式開發工具與模型：在 Codex、Claude Code、Claude Desktop 和 Grok Build 中使用你選擇的供應商，並透過代管設定連接更多工具。',
	ru: 'Единый локальный шлюз для ваших ИИ-инструментов для кода и моделей: используйте выбранных провайдеров в Codex, Claude Code, Claude Desktop и Grok Build и подключайте другие инструменты через управляемые конфигурации.',
	ja: 'AI コーディングツールとモデルをつなぐ 1 つのローカルゲートウェイ。Codex、Claude Code、Claude Desktop、Grok Build で好きなプロバイダーを使い、管理された設定でほかのツールも接続できます。',
	tr: 'Yapay zekâ kodlama araçlarınız ve modelleriniz için tek bir yerel ağ geçidi: Codex, Claude Code, Claude Desktop ve Grok Build ile seçtiğiniz sağlayıcıları kullanın, diğer araçları yönetilen yapılandırmalarla bağlayın.',
} as const;

type GraphNode = Record<string, unknown>;

const graph: GraphNode[] = [
	{
		'@type': 'WebSite',
		// Per-locale @id: the English root and each translated home page describe
		// distinct localized entities instead of redeclaring one shared object.
		'@id': `${homeUrl}#website`,
		url: homeUrl,
		// `name` matches the visible site name (header wordmark + <title> prefix),
		// which is what Google requires before it will adopt it over the domain.
		name: 'opencodex',
		alternateName: 'ocx',
		description: descriptions[inLanguage],
		inLanguage,
	},
];

// The software entity is site-wide truth, so it stays anchored to the English
// root and is emitted exactly once, from the English home page.
if (!locale) {
	graph.push({
		'@type': 'SoftwareApplication',
		'@id': `${SITE_URL}/#software`,
		name: 'opencodex',
		alternateName: 'ocx',
		description:
			'Local gateway that connects AI coding tools — OpenAI Codex (CLI, App, SDK), Claude Code, Claude Desktop, Grok Build and tools with managed configs — to the model providers you choose: Claude, Gemini, Grok, DeepSeek, Kimi, Qwen, Ollama, OpenRouter, and more, with streaming, tool calls, reasoning tokens, and images where the client, model and provider support them.',
		keywords:
			'codex, claude code, claude desktop, grok build, ai coding tools gateway, openai codex proxy, claude code proxy, llm proxy, ai gateway, anthropic, gemini, grok, deepseek, ollama, openrouter, responses api, codex cli',
		featureList: [
			'Connect Codex CLI/App/SDK, Claude Code, Claude Desktop and Grok Build to the providers you choose',
			'Managed config integrations for OpenCode, Pi, Qoder, WorkBuddy, Kilo, Cline, T3 Code and more',
			'Accepts the Responses, Chat Completions and Anthropic Messages APIs',
			'ChatGPT account pool with quota-aware routing',
			'Streaming, tool calls, reasoning tokens, and vision where the client, model and provider support them',
			'Web dashboard on localhost:10100',
		],
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'macOS, Linux, Windows',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		softwareHelp: { '@type': 'CreativeWork', url: `${SITE_URL}/` },
		downloadUrl: 'https://www.npmjs.com/package/@bitkyc08/opencodex',
		url: 'https://github.com/lidge-jun/opencodex',
	});
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script type="application/ld+json" is:inline set:html={jsonLd} />
