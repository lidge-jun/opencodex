---
// Custom Starlight header: default chrome (title / search / social) plus a
// desktop-only hover-dropdown nav and custom preference controls in the
// liquid-glass grammar.
// Mobile (<72rem) hides the nav; the built-in hamburger flow is untouched.
import { Icon } from '@astrojs/starlight/components';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import { GITHUB_URL, getStarCount, formatStarCount } from '../data/github-stars';

const { locale } = Astro.locals.starlightRoute;
// Splash pages have no Starlight sidebar/hamburger, so the pill carries its own
// menu below the desktop-nav breakpoint.
const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
// Root locale is `undefined`; BASE_URL already ends with a slash.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = locale ? `${base}${locale}/` : base;

type NavLink = { label: string; href: string };
type NavGroup = { label: string; links: NavLink[]; more?: NavLink };

// Cloudlight sub-link rows: every dropdown entry gets a tinted icon tile.
// Lucide outline paths (24x24, stroke), keyed by the link's slug.
const ICONS: Record<string, string> = {
	'getting-started/installation/': 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3',
	'getting-started/quickstart/': 'M13 2 3 14h9l-1 8 10-12h-9l1-8Z',
	'getting-started/how-it-works/': 'M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM18 9a9 9 0 0 1-9 9',
	'getting-started/for-agents/': 'M12 8V4H8m8 0h-4M4 12a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Zm11 3h.01M9 15h.01',
	'guides/providers/': 'M12 22v-5M9 8V2M15 8V2M6 8h12l-1 6a5 5 0 0 1-10 0Z',
	'guides/model-routing/': 'M6 19a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM18 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM9 16h5.5a3.5 3.5 0 0 0 0-7H15',
	'guides/combos/': 'm12 2 10 5-10 5L2 7Zm-10 10 10 5 10-5M2 17l10 5 10-5',
	'guides/codex-integration/': 'M16 18l6-6-6-6M8 6l-6 6 6 6',
	'guides/codex-app-models/': 'M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Zm6-2v18M3 9h6',
	'guides/claude-code/': 'M4 17l6-6-6-6M12 19h8',
	'guides/sidecars/': 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35',
	'guides/image-bridge/': 'M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Zm6 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12 4-3.09-3.09a2 2 0 0 0-2.82 0L6 21',
	'guides/video-bridge/': 'm16 13 5.22 3.48a.5.5 0 0 0 .78-.42V7.94a.5.5 0 0 0-.76-.43L16 10.5M4 6h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z',
	'guides/web-dashboard/': 'M3 3v16a2 2 0 0 0 2 2h16M7 16V9m5 7V5m5 11v-4',
	'guides/sub-agent-surface/': 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
	'reference/cli/': 'M4 17l6-6-6-6M12 19h8',
	'reference/configuration/': 'M20 7h-9M14 17H5M17 20a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM7 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
	'reference/adapters/': 'M12 22v-5M9 8V2M15 8V2M6 8h12l-1 6a5 5 0 0 1-10 0Z',
	'reference/architecture/': 'M3 3h7v7H3Zm11 0h7v7h-7Zm0 11h7v7h-7ZM3 14h7v7H3Z',
	'reference/proxy-formats/': 'M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1m8 0h1a2 2 0 0 0 2-2v-5a2 2 0 0 1 2-2 2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1',
	'reference/management-api/': 'M2 4h20v6H2Zm0 10h20v6H2ZM6 7h.01M6 17h.01',
};
const iconFor = (href: string) => ICONS[href.slice(prefix.length)] ?? ICONS['guides/codex-integration/'];

const fr = {
	'Auto': 'Automatique',
	'Light': 'Clair',
	'Dark': 'Sombre',
	'Theme': 'Thème',
	'Click to use the next theme': 'Cliquez pour passer au thème suivant',
	'Getting Started': 'Premiers pas',
	'Installation': 'Installation',
	'Quickstart': 'Démarrage rapide',
	'How It Works': 'Fonctionnement',
	'Agent Quickstart': 'Démarrage rapide pour les agents',
	'Guides': 'Guides',
	'Providers': 'Fournisseurs',
	'Model Routing': 'Routage des modèles',
	'Combos': 'Combinaisons',
	'Codex Integration': 'Intégration de Codex',
	'Codex App Model Picker': 'Sélecteur de modèles de Codex App',
	'Sidecars: Search & Vision': 'Services auxiliaires : recherche et vision',
	'Image Bridge': 'Pont d’images',
	'Video Bridge': 'Pont vidéo',
	'Web Dashboard': 'Tableau de bord web',
	'Sub-agent Surface': 'Interface des sous-agents',
	'Reference': 'Référence',
	'Configuration': 'Configuration',
	'Adapters': 'Adaptateurs',
	'Architecture': 'Architecture',
	'Proxy API Formats': 'Formats de l’API proxy',
	'Management API': 'API de gestion',
	'Contributing': 'Contribuer',
	'Main': 'Navigation principale',
	'Select language': 'Choisir la langue',
	'Menu': 'Menu',
	'GitHub': 'GitHub',
	'GitHub, {count} stars': 'GitHub, {count} étoiles',
} as const;

const t = <K extends keyof typeof fr>(en: K, ko: string, zh: string, ru: string, ja: string, zhTW: string, tr: string): string =>
	locale === 'fr' ? fr[en] : locale === 'ko' ? ko : locale === 'zh-cn' ? zh : locale === 'zh-tw' ? zhTW : locale === 'ru' ? ru : locale === 'ja' ? ja : locale === 'tr' ? tr : en;

const starCount = await getStarCount();
const starLocale = locale ?? 'en';
const githubLabel = t('GitHub', 'GitHub', 'GitHub', 'GitHub', 'GitHub', 'GitHub', 'GitHub');
const starLabel = t(
	'GitHub, {count} stars', 'GitHub, 스타 {count}개', 'GitHub，{count} 个星标',
	'GitHub, звёзд: {count}', 'GitHub、{count} スター', 'GitHub，{count} 個星標', 'GitHub, {count} yıldız',
);
const githubAccessibleName = starCount === null ? githubLabel
	: starLabel.replace('{count}', starCount.toLocaleString(starLocale));

type LanguageOption = { code: 'root' | 'fr' | 'ko' | 'zh-cn' | 'zh-tw' | 'ru' | 'ja' | 'tr'; label: string };
const languages: LanguageOption[] = [
	{ code: 'root', label: 'English' },
	{ code: 'fr', label: 'Français' },
	{ code: 'ko', label: '한국어' },
	{ code: 'zh-cn', label: '简体中文' },
	{ code: 'zh-tw', label: '繁體中文' },
	{ code: 'ru', label: 'Русский' },
	{ code: 'ja', label: '日本語' },
	{ code: 'tr', label: 'Türkçe' },
];
const currentLanguage = languages.find(({ code }) => code === (locale ?? 'root')) ?? languages[0];

// Preserve the current document path when switching locale. Starlight's root
// locale has no URL segment, while every translated locale does.
const routePrefix = locale ? `${base}${locale}/` : base;
const routeSuffix = Astro.url.pathname.startsWith(routePrefix)
	? Astro.url.pathname.slice(routePrefix.length)
	: '';
const languageHref = (code: LanguageOption['code']) =>
	`${code === 'root' ? base : `${base}${code}/`}${routeSuffix}`;

const themeLabels = {
	auto: t('Auto', '자동', '自动', 'Авто', '自動', '自動', 'Otomatik'),
	light: t('Light', '라이트', '浅色', 'Светлая', 'ライト', '淺色', 'Açık'),
	dark: t('Dark', '다크', '深色', 'Тёмная', 'ダーク', '深色', 'Koyu'),
};
const themeName = t('Theme', '테마', '主题', 'Тема', 'テーマ', '主題', 'Tema');
const themeCycleHint = t(
	'Click to use the next theme',
	'클릭하여 다음 테마로 전환',
	'点击切换到下一个主题',
	'Нажмите, чтобы включить следующую тему',
	'クリックして次のテーマに切り替え',
	'點選切換到下一個主題',
	'Sonraki temaya geçmek için tıklayın'
);

const groups: NavGroup[] = [
	{
		label: t('Getting Started', '시작하기', '开始使用', 'Начало работы', 'はじめに', '開始使用', 'Başlangıç'),
		links: [
			{ label: t('Installation', '설치', '安装', 'Установка', 'インストール', '安裝', 'Kurulum'), href: `${prefix}getting-started/installation/` },
			{ label: t('Quickstart', '빠른 시작', '快速开始', 'Быстрый старт', 'クイックスタート', '快速入門', 'Hızlı Başlangıç'), href: `${prefix}getting-started/quickstart/` },
			{ label: t('How It Works', '동작 원리', '工作原理', 'Как это работает', '仕組み', '運作原理', 'Nasıl Çalışır'), href: `${prefix}getting-started/how-it-works/` },
			{ label: t('Agent Quickstart', '에이전트용 빠른 시작', 'Agent 快速上手', 'Быстрый старт для агентов', 'エージェント向けクイックスタート', 'Agent 快速上手', 'Ajanlar İçin Hızlı Başlangıç'), href: `${prefix}getting-started/for-agents/` },
		],
	},
	{
		label: t('Guides', '가이드', '指南', 'Руководства', 'ガイド', '指南', 'Kılavuzlar'),
		links: [
			{ label: t('Providers', '프로바이더', '提供商', 'Провайдеры', 'プロバイダー', '供應商', 'Sağlayıcılar'), href: `${prefix}guides/providers/` },
			{ label: t('Model Routing', '모델 라우팅', '模型路由', 'Маршрутизация моделей', 'モデルルーティング', '模型路由', 'Model Yönlendirme'), href: `${prefix}guides/model-routing/` },
			{ label: t('Combos', '콤보', '组合', 'Комбо', 'コンボ', '組合', 'Kombolar'), href: `${prefix}guides/combos/` },
			{ label: t('Codex Integration', 'Codex 통합', 'Codex 集成', 'Интеграция с Codex', 'Codex 連携', 'Codex 整合', 'Codex Entegrasyonu'), href: `${prefix}guides/codex-integration/` },
			{ label: t('Codex App Model Picker', 'Codex App 모델 선택기', 'Codex App 模型选择器', 'Селектор моделей Codex App', 'Codex App モデルピッカー', 'Codex App 模型選擇器', 'Codex App Model Seçici'), href: `${prefix}guides/codex-app-models/` },
			{ label: 'Claude Code', href: `${prefix}guides/claude-code/` },
			{ label: t('Sidecars: Search & Vision', '사이드카: 검색 & 비전', '边车：搜索与视觉', 'Сайдкары: поиск и зрение', 'サイドカー: 検索 & ビジョン', '邊車：搜尋與視覺', "Sidecar'lar: Arama & Görme"), href: `${prefix}guides/sidecars/` },
			{ label: t('Image Bridge', '이미지 브릿지', '图像桥接', 'Image Bridge', '画像ブリッジ', '圖像橋接', 'Image Bridge'), href: `${prefix}guides/image-bridge/` },
			{ label: t('Video Bridge', '비디오 브릿지', '视频桥接', 'Video Bridge', '動画ブリッジ', '影片橋接', 'Video Bridge'), href: `${prefix}guides/video-bridge/` },
			{ label: t('Web Dashboard', '웹 대시보드', '网页控制台', 'Веб-дашборд', 'ウェブダッシュボード', '網頁儀表板', 'Web Kontrol Paneli'), href: `${prefix}guides/web-dashboard/` },
			{ label: t('Sub-agent Surface', '서브에이전트 서피스', '子代理界面', 'Интерфейс подагентов', 'サブエージェントサーフェス', '子代理介面', 'Alt Ajan Arayüzü'), href: `${prefix}guides/sub-agent-surface/` },
		],
	},
	{
		label: t('Reference', '레퍼런스', '参考', 'Справочник', 'リファレンス', '參考', 'Referans'),
		links: [
			{ label: 'CLI', href: `${prefix}reference/cli/` },
			{ label: t('Configuration', '설정', '配置', 'Конфигурация', '設定', '設定', 'Yapılandırma'), href: `${prefix}reference/configuration/` },
			{ label: t('Adapters', '어댑터', '适配器', 'Адаптеры', 'アダプター', '適配器', 'Adaptörler'), href: `${prefix}reference/adapters/` },
			{ label: t('Architecture', '아키텍처', '架构', 'Архитектура', 'アーキテクチャ', '架構', 'Mimari'), href: `${prefix}reference/architecture/` },
			{ label: t('Proxy API Formats', '프록시 API 형식', '代理 API 格式', 'Форматы API прокси', 'プロキシAPI形式', '代理 API 格式', 'Proxy API Formatları'), href: `${prefix}reference/proxy-formats/` },
			{ label: t('Management API', '관리 API', '管理 API', 'API управления', '管理API', '管理 API', "Yönetim API'si"), href: `${prefix}reference/management-api/` },
		],
	},
];

// Eleven guides made the Guides panel read like a sitemap. The panel keeps
// the six people reach for first and ends in a link to the full docs map on
// the landing page (the sidebar still lists every guide on docs pages).
const GUIDE_PICKS = ['providers', 'model-routing', 'codex-integration', 'claude-code', 'sidecars', 'web-dashboard'];
const guides = groups[1];
guides.links = guides.links.filter((link) => GUIDE_PICKS.some((slug) => link.href.endsWith(`guides/${slug}/`)));
guides.more = {
	label: t('All guides', '가이드 전체 보기', '全部指南', 'Все руководства', 'すべてのガイド', '全部指南', 'Tüm kılavuzlar'),
	href: `${prefix}#docs-map`,
};

const contributing: NavLink = {
	label: t('Contributing', '기여하기', '贡献指南', 'Участие в проекте', 'コントリビュート', '貢獻指南', 'Katkıda Bulunma'),
	href: `${prefix}contributing/`,
};
---

<div class="header" data-splash={isSplash ? '' : undefined}>
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="glass-nav print:hidden" aria-label={t('Main', '주 메뉴', '主导航', 'Основная навигация', 'メインナビゲーション', '主導航', 'Ana Menü')}>
		<span class="nav-top-hl" aria-hidden="true"></span>
		<ul>
			{
				groups.map((group, i) => (
					<li class="nav-item">
						<button type="button" class="nav-link" aria-haspopup="true" aria-expanded="false" aria-controls={`nav-drop-${i}`}>
							{group.label}
							<svg viewBox="0 0 16 16" width="10" height="10" fill="none" aria-hidden="true">
								<path d="M3.5 6l4.5 4.5L12.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div class="nav-drop" id={`nav-drop-${i}`}>
							<div class="nav-panel">
							<span class="nav-hl" aria-hidden="true"></span>
							<p class="nav-drop-head" aria-hidden="true">{group.label}</p>
							<ul>
								{group.links.map((link) => (
									<li>
										<a href={link.href}>
											<span class="nav-tile" aria-hidden="true">
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={iconFor(link.href)} /></svg>
											</span>
											<span class="nav-row-label">{link.label}</span>
											<svg class="nav-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</a>
									</li>
								))}
							</ul>
							{group.more && (
								<a class="nav-more" href={group.more.href}>
									<span>{group.more.label}</span>
									<svg class="nav-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
								</a>
							)}
							</div>
						</div>
					</li>
				))
			}
			<li class="nav-item">
				<a class="nav-link" href={contributing.href}>{contributing.label}</a>
			</li>
		</ul>
	</nav>
	<div class="sl-flex print:hidden search-wrapper">
		<Search />
	</div>
	<a
		class="github-link print:hidden"
		href={GITHUB_URL}
		rel="me"
		aria-label={githubAccessibleName}
	>
		<span class="gh-main" aria-hidden="true">
			<span class="gh-mark">
				<Icon name="github" />
				<span class="gh-burst">{Array.from({ length: 7 }, (_, i) => <span style={`--k:${i}`}></span>)}</span>
			</span>
			<span class="gh-label">Star</span>
		</span>
		{starCount !== null && <span class="gh-count" data-gh-stars={starCount} aria-hidden="true">{formatStarCount(starCount)}</span>}
	</a>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex header-preferences">
			{/*
				[Decision Log]
				- 목적과 의도: Keep theme switching one click away and make locale navigation visually consistent with the site's custom menus.
				- 기존 구현 및 제약 조건: Starlight's native selects inherit browser/OS popup styling and mouse focus borders that cannot match the glass design system.
				- 검토한 주요 대안: Restyle the native selects; replace both with popovers; cycle theme while keeping language as a popover.
				- 선택한 방식: Auto -> Light -> Dark theme cycle button plus a server-rendered language popover.
				- 다른 대안 대신 이 방식을 선택한 이유: Native option popups are not fully styleable, and theme has only three predictable states that do not need a menu.
				- 장점, 단점 및 영향: Consistent chrome and faster theme changes; the cycle order must remain stable and keyboard focus must remain visible.
			*/}
			<button
				type="button"
				class="preference-control theme-cycle"
				data-theme-value="auto"
				data-auto-label={themeLabels.auto}
				data-light-label={themeLabels.light}
				data-dark-label={themeLabels.dark}
				data-theme-name={themeName}
				data-cycle-hint={themeCycleHint}
				aria-label={`${themeName}: ${themeLabels.auto}. ${themeCycleHint}`}
				title={`${themeName}: ${themeLabels.auto}`}
			>
				<span class="preference-icon" data-theme-icon="auto"><Icon name="laptop" /></span>
				<span class="preference-icon" data-theme-icon="light" hidden><Icon name="sun" /></span>
				<span class="preference-icon" data-theme-icon="dark" hidden><Icon name="moon" /></span>
				<span data-theme-label>{themeLabels.auto}</span>
			</button>

			<div class="header-preference language-preference">
				<button
					type="button"
					class="preference-control language-trigger"
					aria-haspopup="menu"
					aria-expanded="false"
					aria-controls="language-menu"
					aria-label={t('Select language', '언어 선택', '选择语言', 'Выбрать язык', '言語を選択', '選擇語言', 'Dil seçin')}
				>
					<Icon name="translate" class="preference-icon" />
					<span>{currentLanguage.label}</span>
					<Icon name="down-caret" class="preference-caret" />
				</button>
				<div class="language-menu" id="language-menu" role="menu">
					<ul>
						{languages.map((language) => (
							<li>
								<a
									href={languageHref(language.code)}
									role="menuitemradio"
									aria-checked={language.code === (locale ?? 'root') ? 'true' : 'false'}
								>
									{language.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</div>
	{isSplash && (
		<div class="lp-menu print:hidden">
			<button
				type="button"
				class="lp-menu-btn"
				aria-haspopup="true"
				aria-expanded="false"
				aria-controls="lp-menu-panel"
				aria-label={t('Menu', '메뉴', '菜单', 'Меню', 'メニュー', '選單', 'Menü')}
			>
				<span class="burger" aria-hidden="true"><span></span><span></span></span>
			</button>
			<div class="lp-menu-panel" id="lp-menu-panel">
				{groups.map((group, i) => (
					<details class="lp-menu-group" style={`--i:${i}`}>
						<summary>
							<span>{group.label}</span>
							<svg viewBox="0 0 16 16" width="18" height="18" fill="none" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</summary>
						<div class="lp-menu-region">
							<ul>
								{group.links.map((link) => (
									<li>
										<a href={link.href}>
											<span class="nav-tile" aria-hidden="true">
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={iconFor(link.href)} /></svg>
											</span>
											{link.label}
										</a>
									</li>
								))}
							</ul>
							{group.more && (
