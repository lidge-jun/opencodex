	}
	.lp-menu-group > summary::-webkit-details-marker { display: none; }
	.lp-menu-group > summary svg { color: var(--sl-color-gray-3); transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
	.lp-menu-group[open] > summary svg { transform: rotate(180deg); }
	.lp-menu-contrib > span { color: var(--sl-color-gray-3); font-size: 1rem; }
	/* accordion height animates through grid rows (no JS measuring) */
	.lp-menu-region {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.lp-menu-group[open] .lp-menu-region { grid-template-rows: 1fr; }
	.lp-menu-region > ul { min-height: 0; overflow: hidden; list-style: none; margin: 0; padding: 0 0 0.75rem; }
	.lp-menu-region a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 44px;
		padding: 0.5rem;
		margin-inline: -0.5rem;
		border-radius: 0.5rem;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.lp-menu-region .lp-menu-more {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 44px;
		margin-bottom: 0.75rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
	}
	.lp-menu-region a:hover,
	.lp-menu-region a:focus-visible { background-color: color-mix(in srgb, var(--sl-color-white) 5%, transparent); }
	@media (prefers-reduced-motion: reduce) {
		.lp-menu-panel,
		.lp-menu-group,
		.lp-menu-contrib,
		.lp-menu-region,
		.burger > span { transition: none !important; translate: none !important; }
	}
</style>

<script>
	// Click/Enter/Space toggles the dropdowns (hover and focus-within still work
	// via CSS); Escape or an outside click closes any open menu.
	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>(
			'.glass-nav .nav-link[aria-haspopup], .lp-menu-btn, .language-trigger',
		),
	);
	const closeAll = (except?: HTMLButtonElement) => {
		for (const b of buttons) if (b !== except) b.setAttribute('aria-expanded', 'false');
	};
	for (const btn of buttons) {
		btn.addEventListener('click', () => {
			const open = btn.getAttribute('aria-expanded') === 'true';
			closeAll(btn);
			btn.setAttribute('aria-expanded', String(!open));
		});
	}
	document.addEventListener('click', (e) => {
		if (!(e.target instanceof Element) || !e.target.closest('.glass-nav, .lp-menu, .header-preference')) closeAll();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeAll();
	});

	// The full-screen splash menu locks page scroll while it is open, and
	// following one of its links (same-page anchors included) closes it.
	const menuBtn = document.querySelector<HTMLButtonElement>('.lp-menu-btn');
	if (menuBtn) {
		new MutationObserver(() => {
			document.documentElement.style.overflow =
				menuBtn.getAttribute('aria-expanded') === 'true' ? 'hidden' : '';
		}).observe(menuBtn, { attributeFilter: ['aria-expanded'] });
		document.querySelector('.lp-menu-panel')?.addEventListener('click', (e) => {
			if (e.target instanceof Element && e.target.closest('a')) closeAll();
		});
		matchMedia('(min-width: 72rem)').addEventListener('change', (e) => {
			if (e.matches) closeAll();
		});
	}

	// Cloudlight docking nav: on the landing page the bar starts transparent
	// inside the hero card and scrolls away with it; once the hero has left the
	// viewport a solid bar slides down from the top. Docs pages are always docked.
	const root = document.documentElement;
	const heroCard = document.querySelector<HTMLElement>('.lp-hero-field');
	if (document.querySelector('.header[data-splash]') && heroCard) {
		root.dataset.navSplash = '';
		new IntersectionObserver(
			(entries) => {
				const docked = !(entries[0]?.isIntersecting ?? true);
				if (docked) root.dataset.navDocked = '';
				else delete root.dataset.navDocked;
			},
			{ threshold: 0 },
		).observe(heroCard);
	}

	// The theme has three predictable states, so each activation advances the
	// stable Auto -> Light -> Dark order instead of opening another menu.
	type Theme = 'auto' | 'light' | 'dark';
	const themeOrder: Theme[] = ['auto', 'light', 'dark'];
	const storageKey = 'starlight-theme';
	const preferredTheme = () =>
		window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
	const loadTheme = (): Theme => {
		const stored = localStorage.getItem(storageKey);
		return stored === 'light' || stored === 'dark' ? stored : 'auto';
	};
	const updateThemeButton = (button: HTMLButtonElement, theme: Theme) => {
		const label = button.dataset[`${theme}Label`] ?? theme;
		button.dataset.themeValue = theme;
		button.querySelector<HTMLElement>('[data-theme-label]')!.textContent = label;
		for (const icon of button.querySelectorAll<HTMLElement>('[data-theme-icon]')) {
			icon.hidden = icon.dataset.themeIcon !== theme;
		}
		const themeName = button.dataset.themeName ?? 'Theme';
		button.title = `${themeName}: ${label}`;
		button.setAttribute('aria-label', `${themeName}: ${label}. ${button.dataset.cycleHint ?? ''}`.trim());
	};
	const applyTheme = (button: HTMLButtonElement, theme: Theme) => {
		document.documentElement.dataset.theme = theme === 'auto' ? preferredTheme() : theme;
		localStorage.setItem(storageKey, theme === 'auto' ? '' : theme);
		updateThemeButton(button, theme);
	};
	// Theme switch transition, ported from teamwicked's AnimatedThemeToggler:
	// the new theme opens as a circle from the tap (or the button centre for
	// keyboard use) over 520ms. Browsers without a usable View Transition,
	// and reduced motion, switch instantly.
	const THEME_VT_MS = 520;
	const switchTheme = (button: HTMLButtonElement, apply: () => void, from: { x: number; y: number } | null) => {
		const isWebKit = /AppleWebKit/.test(navigator.userAgent) && !/Chrome|Chromium|Edg|OPR/.test(navigator.userAgent);
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (typeof document.startViewTransition !== 'function' || isWebKit || reduce) {
			apply();
			return;
		}
		const rect = button.getBoundingClientRect();
		const x = from?.x ?? rect.left + rect.width / 2;
		const y = from?.y ?? rect.top + rect.height / 2;
		const vw = window.visualViewport?.width ?? innerWidth;
		const vh = window.visualViewport?.height ?? innerHeight;
		const radius = Math.hypot(Math.max(x, vw - x), Math.max(y, vh - y));
		const root = document.documentElement;
		root.dataset.themeVt = '';
		root.style.setProperty('--theme-vt-duration', `${THEME_VT_MS}ms`);
		const transition = document.startViewTransition(apply);
		transition.finished.finally(() => {
			delete root.dataset.themeVt;
			root.style.removeProperty('--theme-vt-duration');
		});
		transition.ready.then(() => {
			root.animate(
				{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
				{ duration: THEME_VT_MS, easing: 'ease-in-out', fill: 'forwards', pseudoElement: '::view-transition-new(root)' },
			);
		});
	};

	for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-cycle')) {
		applyTheme(button, loadTheme());
		let origin: { x: number; y: number } | null = null;
		button.addEventListener('pointerdown', (e) => {
			if (e.isPrimary) origin = { x: e.clientX, y: e.clientY };
		});
		button.addEventListener('click', () => {
			const current = (button.dataset.themeValue as Theme | undefined) ?? 'auto';
			const next = themeOrder[(themeOrder.indexOf(current) + 1) % themeOrder.length] ?? 'auto';
			const from = origin;
			origin = null;
			// Auto can resolve to the colours already on screen; then there is
			// nothing to reveal, so skip the circle instead of playing it empty.
			const resolved = next === 'auto' ? preferredTheme() : next;
			if (resolved === document.documentElement.dataset.theme) {
				applyTheme(button, next);
				return;
			}
			switchTheme(button, () => applyTheme(button, next), from);
		});
	}
	window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() !== 'auto') return;
		for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-cycle')) {
			applyTheme(button, 'auto');
		}
	});

	// Arrow keys move directly through language links; Escape returns focus to
	// the trigger so keyboard navigation behaves like the other header menus.
	for (const trigger of document.querySelectorAll<HTMLButtonElement>('.language-trigger')) {
		const menu = trigger.parentElement?.querySelector<HTMLElement>('.language-menu');
		const items = Array.from(menu?.querySelectorAll<HTMLAnchorElement>('a[role^="menuitem"]') ?? []);
		trigger.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			event.preventDefault();
			closeAll(trigger);
			trigger.setAttribute('aria-expanded', 'true');
			const target = items[event.key === 'ArrowDown' ? 0 : items.length - 1];
			// The popover intentionally transitions `visibility`; Chromium refuses
			// to focus descendants until that transition has made them visible.
			const focusWhenVisible = (attempt = 0) => {
				if (!target || !menu || trigger.getAttribute('aria-expanded') !== 'true') return;
				if (getComputedStyle(menu).visibility === 'visible') {
					target.focus();
					return;
				}
				if (attempt < 20) requestAnimationFrame(() => focusWhenVisible(attempt + 1));
			};
			focusWhenVisible();
		});
		menu?.addEventListener('keydown', (event) => {
			const activeIndex = items.indexOf(document.activeElement as HTMLAnchorElement);
			if (event.key === 'Escape') {
				event.preventDefault();
				trigger.setAttribute('aria-expanded', 'false');
				trigger.focus();
				return;
			}
			if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
			event.preventDefault();
			const nextIndex =
				event.key === 'Home' ? 0 :
				event.key === 'End' ? items.length - 1 :
				event.key === 'ArrowDown' ? (activeIndex + 1) % items.length :
				(activeIndex - 1 + items.length) % items.length;
			items[nextIndex]?.focus();
		});
	}

	// Sliding highlights: one element per container glides to the hovered or
	// focused item. Entering from outside snaps it into place first so it
	// never sweeps in from the previous, long-gone position.
	const glide = (container: HTMLElement, hl: HTMLElement, items: HTMLElement[]) => {
		const place = (item: HTMLElement, snap: boolean) => {
			const c = container.getBoundingClientRect();
			const r = item.getBoundingClientRect();
			if (snap) hl.setAttribute('data-snap', '');
			hl.style.setProperty('--hl-x', `${r.left - c.left}px`);
			hl.style.setProperty('--hl-y', `${r.top - c.top}px`);
			hl.style.setProperty('--hl-w', `${r.width}px`);
			hl.style.setProperty('--hl-h', `${r.height}px`);
			if (snap) {
				hl.getBoundingClientRect();
				hl.removeAttribute('data-snap');
			}
			hl.setAttribute('data-on', '');
		};
		for (const item of items) {
			item.addEventListener('pointerenter', () => place(item, !hl.hasAttribute('data-on')));
			item.addEventListener('focus', () => place(item, !hl.hasAttribute('data-on')));
		}
		const off = () => hl.removeAttribute('data-on');
		container.addEventListener('pointerleave', off);
		container.addEventListener('focusout', (e) => {
			if (!container.contains(e.relatedTarget as Node | null)) off();
		});
	};
	for (const panel of document.querySelectorAll<HTMLElement>('.nav-panel')) {
		const hl = panel.querySelector<HTMLElement>('.nav-hl');
		if (hl) glide(panel, hl, Array.from(panel.querySelectorAll<HTMLElement>('ul a')));
	}
	const topNav = document.querySelector<HTMLElement>('.glass-nav');
	const topHl = topNav?.querySelector<HTMLElement>('.nav-top-hl');
	if (topNav && topHl) glide(topNav, topHl, Array.from(topNav.querySelectorAll<HTMLElement>(':scope > ul > li > .nav-link')));

	// Star count speeds in once per session with a horizontal motion blur
	// that tracks how fast the number is moving (React Bits speeding-text).
	const ghCount = document.querySelector<HTMLElement>('.github-link [data-gh-stars]');
	const ghTotal = Number(ghCount?.dataset.ghStars);
	const seen = (() => {
		try { return sessionStorage.getItem('ocx-gh-count') === '1'; } catch { return true; }
	})();
	if (ghCount && ghTotal > 0 && !seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		try { sessionStorage.setItem('ocx-gh-count', '1'); } catch {}
		const final = ghCount.textContent ?? '';
		const trim = (n: number) => String(n).replace(/\.0$/, '');
		const format = (n: number) =>
			n < 1000 ? String(n)
			: n < 100_000 ? `${trim(Math.floor(n / 100) / 10)}k`
			: n < 1_000_000 ? `${Math.floor(n / 1000)}k`
			: `${trim(Math.floor(n / 100_000) / 10)}m`;
		const DURATION = 1400;
		const start = performance.now();
		const step = (now: number) => {
			const t = Math.min(1, (now - start) / DURATION);
			const eased = 1 - Math.pow(1 - t, 4);
			const speed = 4 * Math.pow(1 - t, 3);
			ghCount.textContent = t === 1 ? final : format(Math.round(ghTotal * eased));
			ghCount.style.filter = t === 1 ? '' : `blur(${Math.min(2.5, speed * 2.5).toFixed(2)}px)`;
			ghCount.style.transform = t === 1 ? '' : `scaleX(${(1 + speed * 0.06).toFixed(3)})`;
			if (t < 1) requestAnimationFrame(step);
		};
		requestAnimationFrame(step);
	}
</script>
