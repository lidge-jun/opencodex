	{ cmd: 'codex "Write a hello world in Rust"', note: t('Codex now routes through ocx', '이제 Codex가 ocx를 거쳐 실행됨', 'Codex 现在经由 ocx 路由', 'Codex теперь работает через ocx', 'Codex が ocx 経由で動作', 'Codex 現在經由 ocx 路由', 'Codex artık ocx üzerinden yönlendirilir') },
