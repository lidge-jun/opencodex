  <Fragment>
    <Property Id="OCX_TELEMETRY_CHOICE" Value="send" Secure="yes" />
    <Property Id="OCX_TELEMETRY_SEND" Value="1" Secure="yes" />
    <ComponentGroup Id="OcxTelemetryInstallerChoice">
      <Component Id="OcxTelemetryInstallerChoiceRegistry" Directory="INSTALLDIR" Guid="6F2B8A41-3C7D-4E59-9A1F-0D8C5B7E2A93">
        <RegistryValue Root="HKCU" Key="Software\OpenCodex\Telemetry" Name="InstallerChoice" Type="string" Value="[OCX_TELEMETRY_CHOICE]" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <UI>
      <Dialog Id="OcxTelemetryDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Usage statistics" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Anonymous daily usage telemetry:" />
        <Control Id="Point1" Type="Text" X="20" Y="50" Width="330" Height="30" NoPrefix="yes" Text="• Sent once per day to telemetry.opencodex.me: version, OS/arch, install channel, provider kind, coarse model family, active minutes, and request/token/error counts." />
        <Control Id="Point2" Type="Text" X="20" Y="82" Width="330" Height="30" NoPrefix="yes" Text="• Never sent: prompts, model outputs, request/response bodies, API keys, OAuth tokens, account IDs or emails, custom base URLs, hostnames, file paths, or error text." />
        <Control Id="Point3" Type="Text" X="20" Y="114" Width="330" Height="20" NoPrefix="yes" Text="• Public aggregates: project-wide totals are published at opencodex.me/dashboard." />
        <Control Id="Point4" Type="Text" X="20" Y="136" Width="330" Height="10" NoPrefix="yes" Text="• See the exact payload: ocx telemetry status --json" />
        <Control Id="Point5" Type="Text" X="20" Y="148" Width="330" Height="30" NoPrefix="yes" Text="• Turn off anytime: ocx telemetry disable, the Proxy details toggle in the dashboard, or OCX_TELEMETRY=0 / DO_NOT_TRACK=1 in the proxy's own environment (a service does not see variables set in your shell)." />
        <Control Id="PolicyLink" Type="Hyperlink" X="20" Y="182" Width="330" Height="12">
          <Text><![CDATA[<a href="https://opencodex.me/reference/code-signing/#privacy">Read the full privacy policy</a>]]></Text>
        </Control>
        <Control Id="SendCheckBox" Type="CheckBox" X="20" Y="196" Width="330" Height="17" Property="OCX_TELEMETRY_SEND" CheckBoxValue="1" Text="Send anonymous usage statistics" />
        <Control Id="KeepNote" Type="Text" X="34" Y="213" Width="316" Height="10" NoPrefix="yes" Text="Leaving it checked keeps your current choice; it never turns telemetry back on." />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="OCX_TELEMETRY_CHOICE" Value="send">OCX_TELEMETRY_SEND = "1"</Publish>
          <Publish Property="OCX_TELEMETRY_CHOICE" Value="optout">NOT (OCX_TELEMETRY_SEND = "1")</Publish>
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
