<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by desktop/scripts/telemetry-installer-dialog.ts from src/telemetry/disclosure.ts. Do not edit by hand. -->
<?if $(sys.BUILDARCH) = "x86" ?>
<?define OcxTelemetryWin64 = "no" ?>
<?else ?>
<?define OcxTelemetryWin64 = "yes" ?>
<?endif ?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Public: a silent install opts out with OCX_TELEMETRY_CHOICE=optout. -->
    <Property Id="OCX_TELEMETRY_CHOICE" Secure="yes" />
    <Property Id="OCX_TELEMETRY_STAMP" Secure="yes" />
    <Property Id="OCX_TELEMETRY_SEND" Secure="yes" />
    <!-- An upgrade removes the old product early, so read the previous choice first and carry it. -->
    <Property Id="OCX_TELEMETRY_PREVIOUS_CHOICE">
      <RegistrySearch Id="OcxTelemetryPreviousChoice" Root="HKLM" Key="Software\OpenCodex\Telemetry" Name="InstallerChoice" Type="raw" Win64="$(var.OcxTelemetryWin64)" />
    </Property>
    <Property Id="OCX_TELEMETRY_PREVIOUS_STAMP">
      <RegistrySearch Id="OcxTelemetryPreviousStamp" Root="HKLM" Key="Software\OpenCodex\Telemetry" Name="InstallerChoiceStamp" Type="raw" Win64="$(var.OcxTelemetryWin64)" />
    </Property>
    <!-- Fail closed: any command-line value other than send (off, 0, a typo, padding) is an opt-out.
         Every condition here compares with "" because a bare property holding the integer 0 is false. -->
    <SetProperty Action="OcxTelemetryNormalizeChoice" Id="OCX_TELEMETRY_CHOICE" Value="optout" Before="OcxTelemetryStampExplicit" Sequence="both">OCX_TELEMETRY_CHOICE &lt;&gt; "" AND OCX_TELEMETRY_CHOICE ~&lt;&gt; "send"</SetProperty>
    <!-- A choice given on the command line is a new decision: give it a new stamp. The UI phase passes
         its stamp to the install phase, so a carried choice is never re-stamped without the page. -->
    <SetProperty Action="OcxTelemetryStampExplicit" Id="OCX_TELEMETRY_STAMP" Value="[Date] [Time]" Before="AppSearch" Sequence="both">OCX_TELEMETRY_CHOICE &lt;&gt; "" AND OCX_TELEMETRY_STAMP = ""</SetProperty>
    <SetProperty Action="OcxTelemetryKeepChoice" Id="OCX_TELEMETRY_CHOICE" Value="[OCX_TELEMETRY_PREVIOUS_CHOICE]" After="AppSearch" Sequence="both">OCX_TELEMETRY_CHOICE = "" AND OCX_TELEMETRY_PREVIOUS_CHOICE &lt;&gt; ""</SetProperty>
    <SetProperty Action="OcxTelemetryKeepStamp" Id="OCX_TELEMETRY_STAMP" Value="[OCX_TELEMETRY_PREVIOUS_STAMP]" After="OcxTelemetryKeepChoice" Sequence="both">OCX_TELEMETRY_STAMP = "" AND OCX_TELEMETRY_PREVIOUS_STAMP &lt;&gt; ""</SetProperty>
    <!-- The stamp the page started from, restored when Next leaves the carried choice unchanged. -->
    <SetProperty Action="OcxTelemetryCarriedStamp" Id="OCX_TELEMETRY_CARRIED_STAMP" Value="[OCX_TELEMETRY_STAMP]" After="OcxTelemetryKeepStamp" Sequence="ui">OCX_TELEMETRY_STAMP &lt;&gt; ""</SetProperty>
    <!-- After KeepStamp, which runs in both sequences: WiX's linker rejects a parent missing from a sequence. -->
    <SetProperty Action="OcxTelemetryDefaultChoice" Id="OCX_TELEMETRY_CHOICE" Value="send" After="OcxTelemetryKeepStamp" Sequence="both">OCX_TELEMETRY_CHOICE = ""</SetProperty>
    <!-- The box starts checked only when the choice is send, so a carried opt-out (or any other carried value) starts unchecked. -->
    <SetProperty Action="OcxTelemetryCheckBox" Id="OCX_TELEMETRY_SEND" Value="1" After="OcxTelemetryDefaultChoice" Sequence="ui">OCX_TELEMETRY_CHOICE ~= "send"</SetProperty>
    <ComponentGroup Id="OcxTelemetryInstallerChoice">
      <!-- Machine-wide, so an opt-out from a silent install run as SYSTEM reaches every user. -->
      <Component Id="OcxTelemetryInstallerChoiceRegistry" Directory="INSTALLDIR" Guid="B3E1C7D2-58A4-4F0E-9C6B-7A2D41E95F08" Win64="$(var.OcxTelemetryWin64)">
        <RegistryValue Root="HKLM" Key="Software\OpenCodex\Telemetry" Name="InstallerChoice" Type="string" Value="[OCX_TELEMETRY_CHOICE]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\OpenCodex\Telemetry" Name="InstallerChoiceStamp" Type="string" Value="[OCX_TELEMETRY_STAMP]" />
      </Component>
    </ComponentGroup>
    <UI>
      <Dialog Id="OcxTelemetryDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Usage statistics" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Anonymous daily usage telemetry:" />
        <Control Id="Point1" Type="Text" X="20" Y="50" Width="330" Height="30" NoPrefix="yes" Text="• Sent daily to telemetry.opencodex.me: a daily-changing install hash, version, release channel, OS/arch, install channel, first-report flag, provider kind, model family, active minutes, request/token/error counts." />
        <Control Id="Point2" Type="Text" X="20" Y="82" Width="330" Height="30" NoPrefix="yes" Text="• Never sent: prompts, model outputs, request/response bodies, API keys, OAuth tokens, account IDs or emails, custom base URLs, hostnames, file paths, or error text." />
        <Control Id="Point3" Type="Text" X="20" Y="114" Width="330" Height="20" NoPrefix="yes" Text="• Public aggregates: project-wide totals are published at opencodex.me/dashboard." />
        <Control Id="Point4" Type="Text" X="20" Y="136" Width="330" Height="10" NoPrefix="yes" Text="• See the exact payload: ocx telemetry status --json" />
        <Control Id="Point5" Type="Text" X="20" Y="148" Width="330" Height="30" NoPrefix="yes" Text="• Turn off anytime: ocx telemetry disable, the Proxy details toggle in the dashboard, or OCX_TELEMETRY=0 / DO_NOT_TRACK=1 in the proxy's own environment (a service does not see variables set in your shell)." />
        <Control Id="PolicyLink" Type="Hyperlink" X="20" Y="182" Width="330" Height="12">
          <Text><![CDATA[<a href="https://opencodex.me/reference/code-signing/#privacy">Read the full privacy policy</a>]]></Text>
        </Control>
        <Control Id="SendCheckBox" Type="CheckBox" X="20" Y="196" Width="330" Height="17" Property="OCX_TELEMETRY_SEND" CheckBoxValue="1" Text="Send anonymous usage statistics" />
        <Control Id="KeepNote" Type="Text" X="34" Y="213" Width="316" Height="10" NoPrefix="yes" Text="Checked keeps each account's choice; unchecking turns it off for all." />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="OCX_TELEMETRY_CHOICE" Value="send">OCX_TELEMETRY_SEND = "1"</Publish>
          <Publish Property="OCX_TELEMETRY_CHOICE" Value="optout">NOT (OCX_TELEMETRY_SEND = "1")</Publish>
          <Publish Property="OCX_TELEMETRY_STAMP" Value="[Date] [Time]">OCX_TELEMETRY_CHOICE ~&lt;&gt; OCX_TELEMETRY_PREVIOUS_CHOICE</Publish>
          <Publish Property="OCX_TELEMETRY_STAMP" Value="[OCX_TELEMETRY_CARRIED_STAMP]">OCX_TELEMETRY_CHOICE ~= OCX_TELEMETRY_PREVIOUS_CHOICE AND OCX_TELEMETRY_CARRIED_STAMP &lt;&gt; ""</Publish>
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
      <!-- Tauri's template routes WelcomeDlg -> InstallDirDlg at Order 2; the later NewDialog wins. Only when
           NOT Installed (a first install or a major upgrade): a patch of the installed product keeps Tauri's route. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="OcxTelemetryDlg" Order="3">NOT Installed</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="OcxTelemetryDlg" Order="3">NOT Installed</Publish>
    </UI>
  </Fragment>
</Wix>
