{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard-titlebar",
  "description": "Integrated title bar: the loopback dashboard's top strips drag and double-click-zoom the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-scale-factor"
  ]
}
