+  expect((await io.dispatch(io.request("runtime", { action: "stop", confirmed: true }))).status).toBe(403);
+  io.config.runtimeRole = "standalone";
+  expect((await io.dispatch(io.request("runtime", { action: "stop", confirmed: true }))).status).toBe(403);
+  await io.authorize(); io.control.revokeCurrent(io.request("certificate"));
