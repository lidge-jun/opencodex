+    Date.now = () => actualNow() + 5 * 60_000 + 1;
+    original.expiresAt = Date.now() + 60_000;
+    expect((await io.dispatch(io.request("runtime", { action: "stop", confirmed: true }))).status).toBe(403);
+  } finally { Date.now = actualNow; }
